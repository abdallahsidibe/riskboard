# Copier ce fichier en .env et renseigner les valeurs
# Ne jamais committer .env

# ── Application ──────────────────────────────────────────────────────────────
DB_URL=jdbc:postgresql://localhost:5432/riskboard
DB_USERNAME=your_db_username
DB_PASSWORD=your_db_password
DB_NAME=riskboard

# ── Déploiement (INT / PROD) ──────────────────────────────────────────────────
GITHUB_REPOSITORY_OWNER=your_github_owner
IMAGE_TAG=latest
CORS_ALLOWED_ORIGINS=http://194.147.58.6:4201
BACKEND_PORT=8081
FRONTEND_PORT=4201

# ── Observabilité ─────────────────────────────────────────────────────────────
# Mot de passe Grafana admin — choisir un mot de passe fort (min 12 caractères)
GF_SECURITY_ADMIN_PASSWORD=change_me_strong_password
# Port public du reverse proxy Nginx → Grafana (accès : http://194.147.58.6:3000)
GRAFANA_PORT=3000
